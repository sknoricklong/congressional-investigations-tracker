# Env values for the weekly email + feedback channel (never committed).
# Copy to .env.local, fill in the values, then run: bash scripts/setup-env.sh
#
# RESEND_API_KEY: resend.com -> API keys -> create a FULL ACCESS key
#   (send-only keys 401 the audience calls the recipients page needs).
# UPSTASH values: console.upstash.com -> your Redis database -> REST tab.
# The four secrets can be any long random strings (e.g. `openssl rand -hex 32`).
CRON_SECRET=
CONGRESS_TEST_SECRET=
FEEDBACK_ADMIN_SECRET=
CONGRESS_LIST_PASSWORD=
CONGRESS_EMAIL_FROM=
CONGRESS_EMAIL_TO=
CONGRESS_EMAIL_TEST_TO=
RESEND_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
